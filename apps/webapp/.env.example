# --- Runtime (overridable in prod via /config.json) ---
VITE_API_URL=http://localhost:8080
VITE_OIDC_AUTHORITY=https://iam.example.com/realms/mestier
# client_id must be runtime-configurable too: the production image is built
# once and reused across every environment (dev/staging/production), each
# registering its own OIDC client — baking one in at build time would only
# ever be right for one of them. See config.json's "client_id".
VITE_OIDC_CLIENT_ID=mestier-webapp

# --- Build-time (baked into the bundle) ---
VITE_OIDC_REDIRECT_URI=http://localhost:3000/
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
VITE_OIDC_SCOPE="openid profile email"
