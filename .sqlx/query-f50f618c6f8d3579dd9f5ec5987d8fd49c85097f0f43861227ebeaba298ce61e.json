  "query": "UPDATE automation.webhook_endpoint\n               SET url = $2,\n                   description = $3,\n                   enabled = $4,\n                   disabled_at = CASE WHEN $4 THEN NULL ELSE COALESCE(disabled_at, now()) END,\n                   updated_at = now()\n               WHERE id = $1\n               RETURNING id, org_id, url, description, enabled, created_at, updated_at, disabled_at",
