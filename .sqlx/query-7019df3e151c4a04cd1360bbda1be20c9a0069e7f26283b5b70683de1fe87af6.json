{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT k.id, k.org_id, k.name, k.prefix, k.secret_hash, k.created_at,\n                   k.last_used_at, k.revoked_at\n            FROM support_api_keys k\n            JOIN organizations o ON o.id = k.org_id\n            WHERE k.prefix = $1 AND o.deleted_at IS NULL\n            ",
