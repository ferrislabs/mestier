  "query": "\n            SELECT id, org_id, task_id, author_user_id, body, deleted_at, created_at, updated_at\n            FROM task_comments\n            WHERE task_id = $1 AND deleted_at IS NULL\n            ORDER BY created_at ASC, id ASC\n            LIMIT $2 OFFSET $3\n            ",
