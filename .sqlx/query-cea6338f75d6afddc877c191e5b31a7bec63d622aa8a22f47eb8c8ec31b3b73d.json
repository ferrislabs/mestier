  "query": "\n            SELECT id, org_id, employee_id, effective_from, effective_to, created_at, updated_at\n            FROM employee_rhythms\n            WHERE employee_id = $1\n              AND effective_from <= $3\n              AND (effective_to IS NULL OR effective_to > $2)\n            ORDER BY effective_from ASC\n            ",
