{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT d.id, d.project_id, p.name AS project_name, d.title, d.revision, d.issued_on, d.updated_at\n            FROM does d\n            JOIN projects p ON p.id = d.project_id AND p.org_id = d.org_id\n            WHERE d.org_id = $1\n            ORDER BY d.updated_at DESC, d.id\n            LIMIT $2 OFFSET $3\n            ",
