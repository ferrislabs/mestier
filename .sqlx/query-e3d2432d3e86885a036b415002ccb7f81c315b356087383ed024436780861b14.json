  "query": "\n            SELECT id, org_id, campaign_id, title, description, visibility, graph,\n                   allow_multiple_responses, response_cap, metadata, status, public_slug,\n                   opened_at, closed_at\n            FROM survey.survey\n            WHERE org_id = $1\n            ORDER BY created_at DESC, id DESC\n            LIMIT $2 OFFSET $3\n            ",
