  "query": "\n            SELECT id, org_id, name, sku, unit, unit_price_cents, description, deleted_at, created_at, updated_at\n            FROM products\n            WHERE org_id = $1 AND deleted_at IS NULL\n            ORDER BY name ASC, created_at ASC\n            LIMIT $2 OFFSET $3\n            ",
