  "query": "\n            SELECT id, org_id, name, description, archived_at, created_at, updated_at\n            FROM project_templates\n            WHERE org_id = $1\n              AND ($2::boolean OR archived_at IS NULL)\n            ORDER BY name ASC, created_at ASC\n            LIMIT $3 OFFSET $4\n            ",
