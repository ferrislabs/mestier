  "query": "\n            SELECT id, org_id, status, pipeline_stage, name, registration_number, phone, email, deleted_at, created_at, updated_at\n            FROM customers\n            WHERE org_id = $1 AND deleted_at IS NULL\n            ORDER BY name ASC, created_at ASC\n            LIMIT $2 OFFSET $3\n            ",
