  "query": "\n            SELECT stage AS \"stage!\", COUNT(*) AS \"count!\", COALESCE(SUM(amount_cents), 0)::bigint AS \"amount_cents!\"\n            FROM deals\n            WHERE org_id = $1 AND stage IN ('WON', 'LOST') AND closed_at >= $2\n            GROUP BY stage\n            ",
