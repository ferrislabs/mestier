  "query": "\n            SELECT id, org_id, member_id, kind::text AS \"kind!\", starts_at, ends_at, all_day, note, deleted_at, created_at, updated_at\n            FROM absences\n            WHERE org_id = $1 AND deleted_at IS NULL\n            ORDER BY starts_at ASC, id ASC\n            LIMIT $2 OFFSET $3\n            ",
