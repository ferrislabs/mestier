{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, org_id, user_id, channel_id, message_id, kind, read_at, created_at\n            FROM chat.notification\n            WHERE user_id = $1\n              AND org_id = $2\n              AND ($3::bool = false OR read_at IS NULL)\n              AND ($4::uuid IS NULL OR id < $4)\n            ORDER BY id DESC\n            LIMIT $5\n            ",
