  "query": "\n            SELECT id, org_id, label, unit, rate_cents, default_vat_rate_bp, description, deleted_at, created_at, updated_at\n            FROM service_rates\n            WHERE org_id = $1 AND deleted_at IS NULL\n            ORDER BY label ASC, created_at ASC\n            LIMIT $2 OFFSET $3\n            ",
