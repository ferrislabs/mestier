  "query": "\n            SELECT id, org_id, name, hourly_rate_cents, deleted_at, created_at, updated_at\n            FROM equipment\n            WHERE org_id = $1 AND deleted_at IS NULL\n            ORDER BY name ASC, created_at ASC\n            LIMIT $2 OFFSET $3\n            ",
