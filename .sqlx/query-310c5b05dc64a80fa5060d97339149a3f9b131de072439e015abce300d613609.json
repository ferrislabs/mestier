  "query": "\n            UPDATE quotes\n            SET status = CAST($2 AS text)::quote_status, updated_at = $3\n            WHERE id = $1 AND deleted_at IS NULL\n            RETURNING id, org_id, customer_id, property_id, status::text AS \"status!\", total_cents, deleted_at, created_at, updated_at\n            ",
