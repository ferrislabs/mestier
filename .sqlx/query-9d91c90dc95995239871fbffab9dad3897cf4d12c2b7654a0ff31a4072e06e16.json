  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, org_id, member_id, date, kind, start_time, end_time, lunch_start,\n                   lunch_end, note, created_at, updated_at\n            FROM day_overrides\n            WHERE org_id = $1 AND date >= $2 AND date <= $3\n              AND ($4::uuid IS NULL OR member_id = $4)\n            ORDER BY date, member_id\n            ",
