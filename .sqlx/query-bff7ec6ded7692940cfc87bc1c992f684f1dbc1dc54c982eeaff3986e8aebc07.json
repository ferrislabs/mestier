  "query": "\n\t\tSELECT emoji,\n\t\t       COUNT(*)                                    AS \"count!: i64\",\n\t\t       array_agg(user_id ORDER BY created_at)     AS \"user_ids!: Vec<uuid::Uuid>\"\n\t\tFROM chat.message_reactions\n\t\tWHERE message_id = $1\n\t\tGROUP BY emoji\n\t\tORDER BY emoji\n\t\t",
