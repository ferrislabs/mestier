  "query": "UPDATE automation.workflow_folder\n               SET name = COALESCE($3, name),\n                   parent_id = CASE WHEN $4 THEN $5 ELSE parent_id END\n               WHERE org_id = $1 AND id = $2\n               RETURNING id, org_id, parent_id, name, created_at",
