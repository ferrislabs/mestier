  "query": "\n            SELECT id, customer_id, label, address_line, postal_code, city, photo_key, deleted_at, created_at, updated_at\n            FROM customer_contexts\n            WHERE customer_id = $1 AND deleted_at IS NULL\n            ORDER BY label ASC, created_at ASC\n            LIMIT $2 OFFSET $3\n            ",
