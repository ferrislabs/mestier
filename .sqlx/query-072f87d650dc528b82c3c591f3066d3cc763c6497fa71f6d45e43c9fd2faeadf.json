  "query": "\n            SELECT id, org_id, status, pipeline_stage, last_name, first_name, phone, email, deleted_at, created_at, updated_at\n            FROM customers\n            WHERE org_id = $1 AND deleted_at IS NULL\n            ORDER BY last_name ASC, first_name ASC, created_at ASC\n            LIMIT $2 OFFSET $3\n            ",
