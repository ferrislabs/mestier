{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, org_id, name, customer_id, customer_context_id, quote_id, archived_at, created_at, updated_at\n            FROM projects\n            WHERE org_id = $1\n              AND ($2::uuid IS NULL OR customer_id = $2)\n              AND ($3::boolean OR archived_at IS NULL)\n            ORDER BY name ASC, created_at ASC\n            LIMIT $4 OFFSET $5\n            ",
