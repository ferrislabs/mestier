  "query": "\n            SELECT id, org_id, line_id, done_on, status, task_id, proposed_by,\n                   resolved_by, resolved_at, note, created_at\n            FROM maintenance_interventions\n            WHERE org_id = $1 AND status = $2\n            ORDER BY created_at ASC, id ASC\n            LIMIT $3 OFFSET $4\n            ",
